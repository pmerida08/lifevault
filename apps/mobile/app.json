{
  "expo": {
    "name": "LifeVault",
    "slug": "lifevault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Lifevault.png",
    "scheme": "lifevault",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0e1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.lifevault.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Lifevault.png",
        "backgroundColor": "#4d44e3"
      },
      "package": "app.lifevault.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": false,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92fceeed-fce2-4b4a-85c9-9c1087e4a531"
      }
    },
    "owner": "pmerida"
  }
}
